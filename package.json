{
  "name": "transreport",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "npm run dev --workspace frontend",
    "dev:backend": "npm run dev --workspace backend",
    "start:backend": "npm run start --workspace backend",
    "build": "npm run build --workspace frontend",
    "lint": "npm run lint --workspace frontend",
    "preview": "npm run preview --workspace frontend",
    "pwa": "npm run build && npm run preview",
    "probar:cloudinary": "npm run probar:cloudinary --workspace backend --",
    "migrate": "npm run migrate --workspace backend",
    "dispositivo": "npm run dispositivo --workspace backend --",
    "limpiar-archivos": "npm run limpiar-archivos --workspace backend --",
    "test": "npm test --workspace backend",
    "test:frontend": "npm test --workspace frontend"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "overrides": {
    "uuid": "11.1.1"
  }
}
